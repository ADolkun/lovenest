# Runtime state belongs in volumes, never in an image. Keep app/data/ (taxonomy).
/data/
/celerybeat-schedule*

# Local installs, generated files and tests are not production inputs.
.venv/
venv/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
.coverage*
htmlcov/
**/.ruff_cache/
*.egg-info/
/build/
/dist/
/tests/
/conftest.py
secrets/

# Secrets and data dumps never ship, wherever in the context they land: the
# plugin images build from this directory of the live checkout.
**/.env
**/.env.*
!**/.env.example
**/*.sql
**/*.sql.gz
**/*.dump
**/*.bak
**/backups/
**/.hub-credentials.json
